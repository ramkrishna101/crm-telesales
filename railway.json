{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "preDeployCommand": ["sh -c '/app/backend/node_modules/.bin/prisma migrate resolve --rolled-back 20260709080100_add_whatsapp_messages_and_sync_drift --schema /app/backend/prisma/schema.prisma || true'", "/app/backend/node_modules/.bin/prisma migrate deploy --schema /app/backend/prisma/schema.prisma"],
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
